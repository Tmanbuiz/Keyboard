    "Request stopped. Your text has not been changed.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicitud detenida. Tu texto no ha cambiado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Requête arrêtée. Votre texte n’a pas été modifié."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anfrage gestoppt. Dein Text wurde nicht geändert."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicitação interrompida. Seu texto não foi alterado."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقّف الطلب. لم يتغيّر نصك."
          }
        }
      }
    },
    "Works on selected text, or on what you've typed in this paragraph. Runs on this iPhone with Apple Intelligence when your language is supported.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Funciona con el texto seleccionado o con lo escrito en este párrafo. Se ejecuta en este iPhone con Apple Intelligence cuando tu idioma es compatible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fonctionne sur le texte sélectionné ou sur ce que vous avez saisi dans ce paragraphe. S’exécute sur cet iPhone avec Apple Intelligence lorsque votre langue est prise en charge."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Funktioniert mit ausgewähltem Text oder dem, was du in diesem Absatz getippt hast. Läuft auf diesem iPhone mit Apple Intelligence, wenn deine Sprache unterstützt wird."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Funciona com o texto selecionado ou com o que você digitou neste parágrafo. Roda neste iPhone com Apple Intelligence quando o seu idioma é compatível."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل على النص المحدد أو على ما كتبته في هذه الفقرة. يعمل على هذا الـ iPhone باستخدام Apple Intelligence عندما تكون لغتك مدعومة."
          }
        }
      }
    },
    "Works on selected text, or on what you've typed in this paragraph. Uses your WianTribe service, because Apple Intelligence isn't available here.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Funciona con el texto seleccionado o con lo escrito en este párrafo. Usa tu servicio WianTribe, porque Apple Intelligence no está disponible aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fonctionne sur le texte sélectionné ou sur ce que vous avez saisi dans ce paragraphe. Utilise votre service WianTribe, car Apple Intelligence n’est pas disponible ici."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Funktioniert mit ausgewähltem Text oder dem, was du in diesem Absatz getippt hast. Nutzt deinen WianTribe-Dienst, da Apple Intelligence hier nicht verfügbar ist."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Funciona com o texto selecionado ou com o que você digitou neste parágrafo. Usa o seu serviço WianTribe, porque o Apple Intelligence não está disponível aqui."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل على النص المحدد أو على ما كتبته في هذه الفقرة. يستخدم خدمة WianTribe لديك لأن Apple Intelligence غير متاح هنا."
          }
        }
      }
    },
    "Works on selected text, or on what you've typed in this paragraph. Translation runs on this iPhone once the languages are downloaded in the WianTribe app.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Funciona con el texto seleccionado o con lo escrito en este párrafo. La traducción se ejecuta en este iPhone cuando los idiomas están descargados en la app WianTribe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fonctionne sur le texte sélectionné ou sur ce que vous avez saisi dans ce paragraphe. La traduction s’exécute sur cet iPhone une fois les langues téléchargées dans l’app WianTribe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Funktioniert mit ausgewähltem Text oder dem, was du in diesem Absatz getippt hast. Die Übersetzung läuft auf diesem iPhone, sobald die Sprachen in der WianTribe-App geladen sind."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Funciona com o texto selecionado ou com o que você digitou neste parágrafo. A tradução roda neste iPhone quando os idiomas são baixados no app WianTribe."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل على النص المحدد أو على ما كتبته في هذه الفقرة. تعمل الترجمة على هذا الـ iPhone بعد تنزيل اللغات في تطبيق WianTribe."
          }
        }
      }
    },
