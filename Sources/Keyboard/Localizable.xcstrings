{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "Allow Full Access is needed to copy": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se necesita «Permitir acceso completo» para copiar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Autoriser l’accès complet » est requis pour copier"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Kopieren ist „Vollen Zugriff erlauben“ nötig"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "É preciso “Permitir acesso total” para copiar"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يلزم «السماح بالوصول الكامل» للنسخ"
          }
        }
      }
    },
    "Copied": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiado"
