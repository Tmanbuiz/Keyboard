        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiado"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم النسخ"
          }
        }
      }
    },
    "Copied. Paste it anywhere": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiado. Pégalo donde quieras"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copié. Collez-le où vous voulez"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiert. Füge es überall ein"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiado. Cole em qualquer lugar"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم النسخ. الصقه في أي مكان"
          }
        }
      }
    },
    "Copied. Touch and hold your message, then Paste": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiado. Mantén pulsado tu mensaje y toca Pegar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copié. Maintenez votre message, puis touchez Coller"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiert. Halte deine Nachricht gedrückt und tippe auf Einsetzen"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiado. Toque e segure sua mensagem e depois em Colar"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم النسخ. المس رسالتك مطولًا ثم اختر لصق"
          }
        }
      }
    },
