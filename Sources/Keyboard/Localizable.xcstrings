    "Couldn't read that. Try writing a little larger": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer. Prueba a escribir un poco más grande"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Illisible. Essayez d’écrire un peu plus grand"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das konnte nicht gelesen werden. Schreibe etwas größer"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler. Tente escrever um pouco maior"
