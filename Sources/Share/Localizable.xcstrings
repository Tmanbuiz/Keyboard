            "value": "جارٍ الحفظ…"
          }
        }
      }
    },
    "Saved to your WianTribe clipboard": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardado en tu portapapeles de WianTribe"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistré dans votre presse-papiers WianTribe"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In deiner WianTribe-Zwischenablage gespeichert"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvo na sua área de transferência do WianTribe"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم الحفظ في حافظة WianTribe"
          }
        }
      }
    },
    "There's no text or link to save here": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí no hay texto ni enlace para guardar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n’y a ni texte ni lien à enregistrer ici"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier gibt es keinen Text oder Link zum Speichern"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há texto ou link para salvar aqui"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد نص أو رابط للحفظ هنا"
          }
        }
      }
    },
    "Private typing is on. Turn it off to save clipboard entries.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La escritura privada está activada. Desactívala para guardar elementos del portapapeles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La saisie privée est activée. Désactivez-la pour enregistrer des éléments du presse-papiers."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Privates Tippen ist aktiv. Schalte es aus, um Zwischenablage-Einträge zu speichern."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A digitação privada está ativada. Desative-a para salvar itens da área de transferência."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الكتابة الخاصة مفعّلة. أوقفها لحفظ عناصر الحافظة."
          }
        }
      }
    }
  }
