    "Clear clipboard history, pinned text and learned words on this device?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Borrar el historial del portapapeles, el texto fijado y las palabras aprendidas en este dispositivo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Effacer l'historique du presse-papiers, le texte épinglé et les mots appris sur cet appareil ?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagar o histórico da área de transferência, o texto fixado e as palavras aprendidas neste dispositivo?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwischenablageverlauf, angehefteten Text und gelernte Wörter auf diesem Gerät löschen?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد مسح سجل الحافظة والنص المثبت والكلمات المتعلَّمة على هذا الجهاز؟"
          }
        }
      }
    },
