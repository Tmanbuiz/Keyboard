    "Basic typing, spelling suggestions, swipe decoding and emoji run on your iPhone. The app has no analytics, advertising SDK or keystroke logger.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La escritura básica, las sugerencias ortográficas, el deslizamiento y los emojis funcionan en tu iPhone. La app no tiene analíticas, SDK publicitarios ni registro de pulsaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La saisie de base, les suggestions orthographiques, le glissement et les emoji fonctionnent sur votre iPhone. L'app n'a ni outil d'analyse, ni SDK publicitaire, ni enregistreur de frappe."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Digitação básica, sugestões de ortografia, deslizar e emojis rodam no seu iPhone. O app não tem análises, SDK de anúncios nem registro de teclas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Grundlegendes Tippen, Rechtschreibvorschläge, Wischerkennung und Emojis laufen auf deinem iPhone. Die App hat keine Analysen, kein Werbe-SDK und keinen Tastenlogger."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعمل الكتابة الأساسية واقتراحات الإملاء والكتابة بالسحب والرموز التعبيرية على iPhone. لا يحتوي التطبيق على أدوات تحليل أو حزم إعلانات أو مسجل لضغطات المفاتيح."
          }
        }
      }
    },
