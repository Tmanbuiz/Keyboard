    "A backend template is included in the project. No service is deployed or subscription activated by this app. Provider usage charges may apply to your service.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proyecto incluye una plantilla de servidor. Esta app no despliega ningún servicio ni activa suscripciones. Tu proveedor puede cobrar por el uso de tu servicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un modèle de serveur est inclus dans le projet. Cette app ne déploie aucun service et n'active aucun abonnement. Votre fournisseur peut facturer l'utilisation de votre service."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O projeto inclui um modelo de servidor. Este app não implanta nenhum serviço nem ativa assinaturas. Seu provedor pode cobrar pelo uso do seu serviço."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Projekt enthält eine Server-Vorlage. Diese App stellt keinen Dienst bereit und aktiviert kein Abo. Dein Anbieter kann Nutzungsgebühren für deinen Dienst berechnen."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتضمن المشروع قالب خادم. لا ينشر هذا التطبيق أي خدمة ولا يفعّل أي اشتراك. قد يفرض مزوّدك رسوم استخدام على خدمتك."
          }
        }
      }
    },
    "A little more you, in every message.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un poco más de ti en cada mensaje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un peu plus de vous dans chaque message."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um pouco mais de você em cada mensagem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein bisschen mehr du in jeder Nachricht."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لمسة منك في كل رسالة."
          }
        }
      }
    },
