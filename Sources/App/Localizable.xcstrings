    },
    "Try your new keyboard": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba tu nuevo teclado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez votre nouveau clavier"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimente seu novo teclado"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Probiere deine neue Tastatur aus"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جرّب لوحة مفاتيحك الجديدة"
          }
        }
      }
    },
    "Type something here…": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe algo aquí…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écrivez quelque chose ici…"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite algo aqui…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreib hier etwas…"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب شيئًا هنا…"
          }
        }
      }
    },
    "Typing": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escritura"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisie"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Digitação"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الكتابة"
          }
        }
      }
    },
    "Typing works offline without Full Access. Enable Allow Full Access only for clipboard history, media copying and optional online writing tools.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La escritura funciona sin conexión y sin acceso total. Activa «Permitir acceso total» solo para el historial del portapapeles, copiar contenido multimedia y las herramientas de escritura en línea opcionales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La saisie fonctionne hors ligne sans accès complet. Activez « Autoriser l'accès complet » uniquement pour l'historique du presse-papiers, la copie de médias et les outils d'écriture en ligne facultatifs."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A digitação funciona offline sem Acesso Total. Ative “Permitir Acesso Total” apenas para o histórico da área de transferência, copiar mídia e as ferramentas de escrita online opcionais."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen funktioniert offline ohne vollen Zugriff. Aktiviere „Vollen Zugriff erlauben“ nur für den Zwischenablageverlauf, das Kopieren von Medien und optionale Online-Schreibwerkzeuge."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعمل الكتابة دون اتصال ودون وصول كامل. فعّل «السماح بالوصول الكامل» فقط لسجل الحافظة ونسخ الوسائط وأدوات الكتابة الاختيارية عبر الإنترنت."
          }
        }
      }
    },
    "Typing, emoji, stickers and your clipboard work offline. Translation and rewriting run on your iPhone where Apple supports them; your own service covers other languages and GIF search.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La escritura, los emojis, los stickers y el portapapeles funcionan sin conexión. La traducción y la reescritura se hacen en tu iPhone cuando Apple las admite; tu propio servicio cubre otros idiomas y la búsqueda de GIF."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La saisie, les emoji, les autocollants et le presse-papiers fonctionnent hors ligne. La traduction et la réécriture se font sur votre iPhone quand Apple les prend en charge ; votre propre service couvre les autres langues et la recherche de GIF."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Digitação, emojis, figurinhas e a área de transferência funcionam offline. Tradução e reescrita acontecem no seu iPhone quando a Apple oferece suporte; seu próprio serviço cobre outros idiomas e a busca de GIFs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen, Emojis, Sticker und deine Zwischenablage funktionieren offline. Übersetzen und Umschreiben laufen auf deinem iPhone, wo Apple sie unterstützt; dein eigener Dienst deckt andere Sprachen und die GIF-Suche ab."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعمل الكتابة والرموز التعبيرية والملصقات والحافظة دون اتصال. تتم الترجمة وإعادة الصياغة على iPhone حيثما تدعمها Apple، وتغطي خدمتك الخاصة اللغات الأخرى والبحث عن صور GIF."
          }
        }
      }
    },
    "Use as input": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar como entrada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser comme texte"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar como entrada"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als Eingabe verwenden"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدامها كنص"
          }
        }
      }
    },
    "Use the keyboard without Full Access for normal typing. Clipboard history, GIFs, copying stickers, haptics, shared-container writes and your online service need Full Access. Allowing it does not start background text uploads.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el teclado sin acceso total para escribir con normalidad. El historial del portapapeles, los GIF, copiar stickers, la respuesta háptica, el almacenamiento compartido y tu servicio en línea necesitan acceso total. Permitirlo no inicia envíos de texto en segundo plano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez le clavier sans accès complet pour la saisie normale. L'historique du presse-papiers, les GIF, la copie d'autocollants, le retour haptique, le stockage partagé et votre service en ligne nécessitent l'accès complet. L'autoriser ne déclenche aucun envoi de texte en arrière-plan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Use o teclado sem Acesso Total para digitar normalmente. Histórico da área de transferência, GIFs, copiar figurinhas, resposta tátil, armazenamento compartilhado e seu serviço online precisam do Acesso Total. Permitir não inicia envios de texto em segundo plano."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für normales Tippen brauchst du keinen vollen Zugriff. Zwischenablageverlauf, GIFs, Sticker kopieren, Haptik, gemeinsamer Speicher und dein Online-Dienst benötigen vollen Zugriff. Das Erlauben startet keine Textübertragungen im Hintergrund."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم لوحة المفاتيح دون وصول كامل للكتابة العادية. يحتاج سجل الحافظة وصور GIF ونسخ الملصقات والاستجابة اللمسية والتخزين المشترك وخدمتك عبر الإنترنت إلى الوصول الكامل. السماح به لا يبدأ رفع أي نص في الخلفية."
          }
        }
      }
    },
    "Voice editor": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Editor de voz"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Éditeur vocal"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Editor de voz"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spracheditor"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محرر الصوت"
          }
        }
      }
    },
    "Voice recording is available in this app, with microphone and speech permission. Apple's speech recognition may process audio on Apple's servers when on-device recognition is unavailable.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabación de voz está disponible en esta app, con permiso de micrófono y de voz. El reconocimiento de voz de Apple puede procesar el audio en sus servidores cuando no está disponible en el dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'enregistrement vocal est disponible dans cette app, avec l'autorisation du micro et de la reconnaissance vocale. La reconnaissance vocale d'Apple peut traiter l'audio sur ses serveurs si elle n'est pas disponible sur l'appareil."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação de voz está disponível neste app, com permissão de microfone e fala. O reconhecimento de fala da Apple pode processar o áudio nos servidores da Apple quando não estiver disponível no aparelho."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprachaufnahmen sind in dieser App mit Mikrofon- und Spracherkennungsfreigabe möglich. Apples Spracherkennung kann Audio auf Apple-Servern verarbeiten, wenn sie auf dem Gerät nicht verfügbar ist."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسجيل الصوت متاح في هذا التطبيق بإذن الميكروفون والتعرّف على الكلام. قد يعالج التعرّف على الكلام من Apple الصوت على خوادم Apple عندما لا يتوفر على الجهاز."
          }
        }
      }
    },
    "When data can leave your device": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuándo pueden salir datos de tu dispositivo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand des données peuvent quitter l'appareil"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando dados podem sair do aparelho"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wann Daten dein Gerät verlassen können"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متى يمكن أن تغادر البيانات جهازك"
          }
        }
      }
    },
    "Word learning is off by default. It saves word counts, not sentences. Remove personal data inside the keyboard too if your build uses separate storage.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El aprendizaje de palabras está desactivado por defecto. Guarda recuentos de palabras, no frases. Si tu versión usa almacenamiento separado, borra también los datos personales dentro del teclado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'apprentissage des mots est désactivé par défaut. Il enregistre des fréquences de mots, pas des phrases. Si votre version utilise un stockage séparé, effacez aussi les données personnelles dans le clavier."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O aprendizado de palavras vem desativado. Ele salva contagens de palavras, não frases. Se sua versão usa armazenamento separado, apague também os dados pessoais dentro do teclado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Lernen von Wörtern ist standardmäßig aus. Es speichert Worthäufigkeiten, keine Sätze. Wenn deine Version getrennten Speicher nutzt, lösche persönliche Daten auch in der Tastatur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعلُّم الكلمات متوقف افتراضيًا. يحفظ عدد مرات استخدام الكلمات وليس الجمل. إذا كانت نسختك تستخدم تخزينًا منفصلًا، فامسح البيانات الشخصية داخل لوحة المفاتيح أيضًا."
          }
        }
